# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional brand overrides — see src/config/site.ts
# NEXT_PUBLIC_BRAND_NAME=
# NEXT_PUBLIC_BRAND_TAGLINE=

# Newsletter provider. Leave unset to run in "not connected" mode.
# Supported: buttondown
# NEWSLETTER_PROVIDER=buttondown
# BUTTONDOWN_API_KEY=

# Real visitor and click counts (Upstash Redis). Leave unset to disable:
# the site then shows no visitor figures and hides "Popular".
# Vercel's Upstash Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Secret used in the daily visitor hash. Set any long random string.
# VISITOR_SALT=
# Visitor counts below this are hidden (default 50).
# VISITORS_MIN_TO_SHOW=50

# Google Analytics 4 measurement ID. Defaults to the one in src/config/site.ts; set to an empty value to disable.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager container ID. Defaults to the one in src/config/site.ts; set to an empty value to disable.
# NEXT_PUBLIC_GTM_ID=
