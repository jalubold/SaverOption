# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Search Console → Add property (URL prefix) → HTML tag: paste only the content="…" value.
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (msvalidate.01) and Yandex Webmaster, same idea:
# BING_SITE_VERIFICATION=
# YANDEX_SITE_VERIFICATION=

# Optional brand overrides — see src/config/site.ts
# NEXT_PUBLIC_BRAND_NAME=
# NEXT_PUBLIC_BRAND_TAGLINE=

# Newsletter provider. Leave unset to run in "not connected" mode.
# Supported: buttondown
# NEWSLETTER_PROVIDER=buttondown
# BUTTONDOWN_API_KEY=

# Real visitor and click counts (Upstash Redis). Leave unset to disable:
# the site then shows no visitor figures and hides "Popular".
# Vercel's Upstash Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Secret used in the daily visitor hash. Set any long random string.
# VISITOR_SALT=
# Visitor counts below this are hidden (default 0: always show the real number).
# VISITORS_MIN_TO_SHOW=0

# Public /stats page: a Vercel access token that can read this project's Web Analytics.
# Server-only — never prefix it with NEXT_PUBLIC_. Leave unset to show "temporarily unavailable".
# VERCEL_ANALYTICS_TOKEN=
# VERCEL_ANALYTICS_PROJECT_ID=prj_zxMMLKgNfLsnpNTmpNhhniRpRoqb
# VERCEL_ANALYTICS_TEAM_ID=team_d9Zh4wWR5w7IWppQlxs9bIyy

# ── Advertiser listings (Supabase) ───────────────────────────────────────────
# Set automatically by Vercel's Supabase integration. Run supabase/migrations/*.sql first.
# Server code talks to Postgres directly over the pooled URL; the anon key is only used for Auth.
# POSTGRES_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (logo uploads to Storage). Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails that may open /admin (must have a confirmed account).
# ADMIN_EMAILS=

# ── Payments (Lemon Squeezy) — all server-only ──────────────────────────────
# Only the API key is required: /admin/setup → "Connect Lemon Squeezy" finds the store,
# matches the monthly / quarterly / yearly subscription variants (and their prices) and registers the
# webhook. Set the rest only to override.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_ID_MONTHLY=
# LEMONSQUEEZY_VARIANT_ID_QUARTERLY=
# LEMONSQUEEZY_VARIANT_ID_YEARLY=
# Keep false until Lemon Squeezy confirms in writing that paid listings are allowed.
# While false, production saves submissions without charging; previews and admins use test mode.
LEMONSQUEEZY_LIVE_CHECKOUT_ENABLED=false

# Saver Option Business: daily renewal reminders via Vercel Cron (/api/cron/business-reminders).
# Optional — reminders are also created when someone opens the app. Server only.
# CRON_SECRET=

# Optional, server-only: turns on the Saver Option Business AI Savings Assistant (Claude API).
# Without it the assistant page says it isn't configured.
ANTHROPIC_API_KEY=
