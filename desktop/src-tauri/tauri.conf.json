{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saver Option Business",
  "version": "0.2.0",
  "identifier": "com.saveroption.business",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Business",
    "shortDescription": "Software spend, renewals and savings for your company",
    "copyright": "© 2026 Saver Option",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["saveroption-business"]
      }
    }
  }
}
